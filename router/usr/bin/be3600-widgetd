#!/bin/sh
#
# be3600-widgetd -- collects what the screen pages need and writes it, as small text files, to
# /tmp/be3600-widgets (memory, nothing touches flash). The supervisor starts it while the screensaver is
# showing and stops it afterwards; it only collects for the pages listed in PAGES.
#
#   ping.txt      recent round trips to PING_TARGET             (pages: internet, health)
#   wifi.txt      Wi-Fi clients with names, addresses, signal    (clients)
#   vpn.txt       WireGuard / OpenVPN tunnels                    (vpn, health)
#   guest.txt     is the guest Wi-Fi on                          (guest)
#   wifiqr.txt    the network to show as a QR code               (wifiqr)
#   weather.txt   current weather from open-meteo.com            (weather)
#   path.txt      how far out the network works: router, ISP link, internet, names   (doctor)
#   talkers.txt   bytes per device right now, from the kernel's connection table      (talkers)
#   chimes.txt    the fan chimes and whether one would be heard now          (chimes)
#   anims.txt     the saved animations, and which one is playing             (slots)
#   custom-*.txt  output of your scripts in /etc/be3600-screen/widgets.d
#   events        one line per thing worth a banner (internet down/up, new device, VPN change)
#
# Settings are in /etc/be3600-screen/config.

CONF="${BE3600_CONF:-/etc/be3600-screen/config}"
D="${BE3600_DATA:-/tmp/be3600-widgets}"
WIDGETS_D="${BE3600_WIDGETS_D:-/etc/be3600-screen/widgets.d}"
LEASES="${BE3600_LEASES:-/tmp/dhcp.leases}"
PAGES="animations"
PING_TARGET="1.1.1.1"
PING_INTERVAL=5
DNS_PROBE="openwrt.org"
CONNTRACK="${BE3600_CONNTRACK:-/proc/net/nf_conntrack}"
FAN="${BE3600_FAN:-/usr/sbin/be3600-fan}"
ANIM="${BE3600_ANIM:-/usr/sbin/be3600-anim}"
ALERTS=1
WIFI_QR_SECTION=""
WEATHER_LAT=""
WEATHER_LON=""
WEATHER_UNITS="C"
WEATHER_PLACE=""
ONCE="${BE3600_ONCE:-0}"                 # tests: a few rounds, then stop
ONCE_N="${BE3600_ONCE_N:-4}"             # tests: how many rounds that means

# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

mkdir -p "$D"

has() { case " $PAGES " in *" $1 "*) return 0 ;; esac; return 1; }
has_prefix() { case " $PAGES " in *" $1"*) return 0 ;; esac; return 1; }

NEED_PING=0; NEED_WIFI=0; NEED_VPN=0; NEED_GUEST=0; NEED_QR=0; NEED_WEATHER=0; NEED_CUSTOM=0; NEED_PATH=0; NEED_TALKERS=0; NEED_CHIMES=0; NEED_ANIMS=0
{ has internet || has health; }   && NEED_PING=1
has clients                      && NEED_WIFI=1
{ has vpn || has health; }        && NEED_VPN=1
has guest                        && NEED_GUEST=1
has wifiqr                       && NEED_QR=1
has weather                      && NEED_WEATHER=1
{ has custom || has_prefix "custom:"; } && NEED_CUSTOM=1
has doctor                       && NEED_PATH=1
has talkers                      && NEED_TALKERS=1
has chimes                       && NEED_CHIMES=1
has slots                        && NEED_ANIMS=1
# New-device alerts need the client list even when its page is not shown.
[ "$ALERTS" != 0 ] && NEED_WIFI=1

now() { date +%s; }

# Writes stdin to $D/$1 in one step, so a reader never sees half a file.
put() {
    cat > "$D/$1.tmp" && mv "$D/$1.tmp" "$D/$1"
}

event() {   # event LEVEL TEXT
    [ "$ALERTS" = 0 ] && return 0
    echo "$(now)|$1|$2" >> "$D/events"
    if [ "$(wc -l < "$D/events" 2>/dev/null || echo 0)" -gt 100 ]; then
        tail -n 50 "$D/events" > "$D/events.tmp" && mv "$D/events.tmp" "$D/events"
    fi
}

# ---------------------------------------------------------------- ping
PING_HIST=""
PING_LOST=0
PING_DOWN=0

collect_ping() {
    OUT="$(ping -c 1 -W 1 "$PING_TARGET" 2>/dev/null)"
    MS="$(echo "$OUT" | sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' | head -n 1)"
    if [ -n "$MS" ]; then
        PING_LOST=0
        if [ "$PING_DOWN" = 1 ]; then PING_DOWN=0; event good "Internet is back"; fi
    else
        MS=-1
        PING_LOST=$((PING_LOST + 1))
        if [ "$PING_LOST" -ge 3 ] && [ "$PING_DOWN" = 0 ]; then PING_DOWN=1; event bad "Internet is down"; fi
    fi
    PING_HIST="$(echo "$PING_HIST $MS" | tr -s ' ' | awk '{ n = NF; s = n > 60 ? n - 59 : 1; o = ""; for (i = s; i <= n; i++) o = o (o == "" ? "" : " ") $i; print o }')"
    printf 'target=%s\nms=%s\n' "$PING_TARGET" "$PING_HIST" | put ping.txt
}

# ---------------------------------------------------------------- Wi-Fi clients
WIFI_SEEN=""
WIFI_FIRST=1

collect_wifi() {
    IFACES="$(iw dev 2>/dev/null | awk '/Interface/ { i = $2 } /type AP/ { print i }')"
    [ -n "$IFACES" ] || { printf 'count=0\n' | put wifi.txt; return; }
    # station dump -> "mac|signal|band", then joined with the DHCP leases for name and address
    for I in $IFACES; do
        BAND=5G
        iw dev "$I" info 2>/dev/null | grep -q 'channel [0-9]* (2[0-9]* MHz)' && BAND=2.4G
        iw dev "$I" station dump 2>/dev/null | awk -v band="$BAND" '/^Station/ { mac = tolower($2) } /signal:/ && mac != "" { print mac "|" $2 "|" band; mac = "" }'
    done > "$D/stations.tmp"
    awk -F'|' '
        NR == FNR { split($0, a, " "); name[tolower(a[2])] = (a[4] == "*" ? a[2] : a[4]); ip[tolower(a[2])] = a[3]; next }
        { n = ($1 in name) ? name[$1] : $1; i = ($1 in ip) ? ip[$1] : "-"; gsub(/\|/, "", n); print "client|" n "|" i "|" $2 "|" $3 }' "$LEASES" "$D/stations.tmp" > "$D/wifi.body"
    { printf 'count=%s\n' "$(wc -l < "$D/wifi.body")"; cat "$D/wifi.body"; } | put wifi.txt
    # who is new since the last look (not on the first look after starting)
    NOWSEEN="$(cut -d'|' -f1 "$D/stations.tmp" | sort | tr '\n' ' ')"
    if [ "$WIFI_FIRST" = 0 ]; then
        for M in $NOWSEEN; do
            case " $WIFI_SEEN " in *" $M "*) ;; *)
                NM="$(grep -i "$M" "$D/wifi.body" | head -n 1 | cut -d'|' -f2)"
                event info "Device joined: ${NM:-$M}" ;;
            esac
        done
    fi
    WIFI_SEEN="$NOWSEEN"
    WIFI_FIRST=0
    rm -f "$D/stations.tmp" "$D/wifi.body"
}

# ---------------------------------------------------------------- VPN
VPN_PREV=""

collect_vpn() {
    NOWTS="$(now)"
    LINES=""
    if command -v wg >/dev/null 2>&1; then
        for I in $(wg show interfaces 2>/dev/null); do
            TS="$(wg show "$I" latest-handshakes 2>/dev/null | awk '{ if ($2 > m) m = $2 } END { print m + 0 }')"
            AGE=-1
            [ "${TS:-0}" -gt 0 ] && AGE=$((NOWTS - TS))
            if [ "$AGE" -ge 0 ] && [ "$AGE" -lt 300 ]; then LINES="$LINES$I|up|$AGE
"; else LINES="$LINES$I|down|-1
"; fi
        done
    fi
    for T in /sys/class/net/tun[0-9]*; do
        [ -e "$T" ] || continue
        LINES="$LINES$(basename "$T")|up|-1
"
    done
    printf '%s' "$LINES" | put vpn.txt
    STATE="$(printf '%s' "$LINES" | cut -d'|' -f1,2 | tr '\n' ' ')"
    if [ -n "$VPN_PREV" ] && [ "$STATE" != "$VPN_PREV" ]; then
        for E in $STATE; do
            case " $VPN_PREV " in *" $E "*) ;; *)
                N="${E%%|*}"; S="${E##*|}"
                if [ "$S" = up ]; then event good "VPN $N is up"; else event warn "VPN $N dropped"; fi ;;
            esac
        done
    fi
    VPN_PREV="$STATE"
}

# ---------------------------------------------------------------- guest Wi-Fi
guest_sections() { uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)\.guest='1'.*/\1/p"; }

collect_guest() {
    SECS="$(guest_sections)"
    if [ -z "$SECS" ]; then printf 'state=none\n' | put guest.txt; return; fi
    ON=off
    for S in $SECS; do
        [ "$(uci -q get "wireless.$S.disabled")" = 1 ] || ON=on
    done
    SSID="$(uci -q get "wireless.$(echo "$SECS" | head -n 1).ssid")"
    printf 'state=%s\nssid=%s\n' "$ON" "$SSID" | put guest.txt
}

# ---------------------------------------------------------------- Wi-Fi QR code
collect_qr() {
    SEC="$WIFI_QR_SECTION"
    [ -n "$SEC" ] || SEC="$(guest_sections | head -n 1)"
    [ -n "$SEC" ] || SEC="$(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface.*/\1/p" | head -n 1)"
    if [ -z "$SEC" ]; then printf '' | put wifiqr.txt; return; fi
    SSID="$(uci -q get "wireless.$SEC.ssid")"
    KEY="$(uci -q get "wireless.$SEC.key")"
    ENC="$(uci -q get "wireless.$SEC.encryption")"
    [ "$ENC" = none ] && ENC=nopass || ENC=WPA
    # the password is in this file: only the owner may read it
    ( umask 077; printf 'ssid=%s\nenc=%s\nkey=%s\n' "$SSID" "$ENC" "$KEY" > "$D/wifiqr.tmp"; mv "$D/wifiqr.tmp" "$D/wifiqr.txt" )
}

# ---------------------------------------------------------------- weather
collect_weather() {
    [ -n "$WEATHER_LAT" ] && [ -n "$WEATHER_LON" ] || return 0
    UNIT=celsius; SYM=C
    [ "$WEATHER_UNITS" = F ] && { UNIT=fahrenheit; SYM=F; }
    URL="https://api.open-meteo.com/v1/forecast?latitude=$WEATHER_LAT&longitude=$WEATHER_LON&current=temperature_2m,weather_code,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min&temperature_unit=$UNIT&timezone=auto&forecast_days=1"
    J="$(curl -s -m 10 "$URL" 2>/dev/null)" || return 0
    [ -n "$J" ] || return 0
    T="$(jsonfilter -s "$J" -e '@.current.temperature_2m')"
    [ -n "$T" ] || return 0
    printf 'temp=%s\ncode=%s\nwind=%s\nhi=%s\nlo=%s\nunit=%s\nplace=%s\n' "$T" \
        "$(jsonfilter -s "$J" -e '@.current.weather_code')" "$(jsonfilter -s "$J" -e '@.current.wind_speed_10m')" \
        "$(jsonfilter -s "$J" -e '@.daily.temperature_2m_max[0]')" "$(jsonfilter -s "$J" -e '@.daily.temperature_2m_min[0]')" \
        "$SYM" "$WEATHER_PLACE" | put weather.txt
}

# ---------------------------------------------------------------- your own scripts
collect_custom() {
    [ -d "$WIDGETS_D" ] || return 0
    for F in "$WIDGETS_D"/*.sh; do
        [ -f "$F" ] || continue
        N="$(basename "$F" .sh)"
        IV="$(sed -n 's/^# *interval: *\([0-9][0-9]*\).*/\1/p' "$F" | head -n 1)"
        [ -n "$IV" ] || IV=30
        [ "$IV" -ge 5 ] || IV=5
        LAST="$(cat "$D/.custom-$N" 2>/dev/null || echo 0)"
        [ $(($(now) - LAST)) -ge "$IV" ] || continue
        now > "$D/.custom-$N"
        # five seconds at most, and only the first 2 KB of what it prints
        timeout 5 sh "$F" 2>/dev/null | head -c 2048 | put "custom-$N.txt"
    done
}

# ---------------------------------------------------------------- network doctor
# How far out does the network work? Each stop is timed on its own, so the first one that fails is the culprit.
ping_ms() {
    [ -n "$1" ] || { echo -1; return; }
    MS="$(ping -c 1 -W 2 "$1" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' | head -n 1)"
    echo "${MS:--1}"
}

dns_ms() {
    if command -v dig >/dev/null 2>&1; then
        MS="$(dig +tries=1 +time=2 "$DNS_PROBE" 2>/dev/null | sed -n 's/^;; Query time: \([0-9]*\) msec.*/\1/p' | head -n 1)"
        echo "${MS:--1}"
    elif nslookup "$DNS_PROBE" >/dev/null 2>&1; then
        echo 0                      # it works, but this router cannot time it
    else
        echo -1
    fi
}

collect_path() {
    GW="$(ip route show default 2>/dev/null | awk '/default/ { print $3; exit }')"
    printf 'gw=%s\ngw_ms=%s\nnet_ms=%s\ndns_ms=%s\n' \
        "$GW" "$(ping_ms "$GW")" "$(ping_ms "$PING_TARGET")" "$(dns_ms)" | put path.txt
}

# ---------------------------------------------------------------- who is using the internet
# The kernel already counts the bytes of every connection (nf_conntrack_acct), so nothing is added to the
# firewall: this only reads. Each round remembers the byte count of every flow and adds up what grew since.
collect_talkers() {
    [ -r "$CONNTRACK" ] || { printf '' | put talkers.txt; return; }
    NOWTS="$(now)"
    awk -v now="$NOWTS" -v state="$D/.flows" -v leases="$LEASES" '
        function lan(a) { return a ~ /^192\.168\./ || a ~ /^10\./ || a ~ /^172\.(1[6-9]|2[0-9]|3[01])\./ }
        BEGIN {
            tmpf = state ".tmp"
            then = 0
            while ((getline line < state) > 0) {
                split(line, p, " ")
                if (p[1] == "#t") { then = p[2] + 0; continue }
                was_up[p[1]] = p[2] + 0
                was_down[p[1]] = p[3] + 0
                known[p[1]] = 1
            }
            close(state)
            while ((getline line < leases) > 0) {
                split(line, l, " ")
                if (l[4] != "" && l[4] != "*") name[l[3]] = l[4]
            }
            close(leases)
            dt = now - then
            if (dt < 1 || dt > 600) dt = 0          # no previous round (or a very old one): only remember
        }
        {
            sc = 0; dc = 0; bc = 0; pc = 0
            src = ""; dst = ""; sport = ""; dport = ""; b1 = 0; b2 = 0
            for (i = 1; i <= NF; i++) {
                if (substr($i, 1, 4) == "src=") { sc++; if (sc == 1) src = substr($i, 5) }
                else if (substr($i, 1, 4) == "dst=") { dc++; if (dc == 1) dst = substr($i, 5) }
                else if (substr($i, 1, 6) == "sport=") { pc++; if (pc == 1) sport = substr($i, 7) }
                else if (substr($i, 1, 6) == "dport=") { if (dport == "") dport = substr($i, 7) }
                else if (substr($i, 1, 6) == "bytes=") { bc++; if (bc == 1) b1 = substr($i, 7) + 0; else if (bc == 2) b2 = substr($i, 7) + 0 }
            }
            if (src == "" || !lan(src) || lan(dst)) next
            key = src ":" sport "-" dst ":" dport
            seen[key] = b1 " " b2
            if (dt > 0) {
                if (known[key]) {
                    u = b1 - was_up[key]; if (u < 0) u = 0
                    d = b2 - was_down[key]; if (d < 0) d = 0
                } else { u = b1; d = b2 }           # a connection that started during this round
                up[src] += u
                down[src] += d
            }
        }
        END {
            printf "#t %d\n", now > tmpf
            for (k in seen) printf "%s %s\n", k, seen[k] > tmpf
            close(tmpf)
            if (dt <= 0) exit
            for (a in down) {
                if (down[a] + up[a] < 256) continue          # ignore the trickle of keep-alives
                n = (a in name) ? name[a] : a
                gsub(/\|/, "", n)
                printf "%d\tdev|%s|%.0f|%.0f\n", down[a] + up[a], n, down[a] / dt, up[a] / dt
            }
        }
    ' "$CONNTRACK" | sort -rn | cut -f2- | head -n 8 | put talkers.txt
    [ -f "$D/.flows.tmp" ] && mv "$D/.flows.tmp" "$D/.flows"
}
# ---------------------------------------------------------------- the fan chimes
# The list changes only when you add or remove one, but "would it be heard right now" changes
# with the temperature and the clock, so this is re-read every half minute.
collect_chimes() {
    [ -x "$FAN" ] || { printf 'state\tnofan\n' | put chimes.txt; return; }
    "$FAN" chimes --plain 2>/dev/null | put chimes.txt
}

# ---------------------------------------------------------------- the saved animations
# The same list Motion Studio sees, for the slots page. Working out each one's length means
# reading the whole file, which is by far the dearest thing here, so it is only done when the
# library has actually changed. The page also drops a slot itself the moment you remove one.
ANIM_LIB="${BE3600_LIB:-/etc/be3600-screen/animations}"
ANIM_ACTIVE="${BE3600_ACTIVE:-/etc/be3600-screen/active.bea}"
ANIM_SIG=""

collect_anims() {
    [ -x "$ANIM" ] || return 0
    # shellcheck disable=SC2012  # BusyBox has no reliable stat; size and time from ls is enough here
    SIG="$(ls -ln "$ANIM_LIB"/*.bea "$ANIM_ACTIVE" 2>/dev/null | awk '{print $5 $6 $7 $8 $9}')"
    [ "$SIG" = "$ANIM_SIG" ] && [ -f "$D/anims.txt" ] && return 0
    ANIM_SIG="$SIG"
    "$ANIM" list --plain 2>/dev/null | put anims.txt
}

# ---------------------------------------------------------------- the loop
N=0
while :; do
    [ "$NEED_PING" = 1 ] && [ $((N % PING_INTERVAL)) -eq 0 ] && collect_ping
    [ "$NEED_WIFI" = 1 ] && [ $((N % 10)) -eq 0 ] && collect_wifi
    [ "$NEED_VPN" = 1 ] && [ $((N % 10)) -eq 2 ] && collect_vpn
    [ "$NEED_GUEST" = 1 ] && [ $((N % 5)) -eq 1 ] && collect_guest
    [ "$NEED_QR" = 1 ] && [ $((N % 60)) -eq 0 ] && collect_qr
    [ "$NEED_WEATHER" = 1 ] && [ $((N % 900)) -eq 3 ] && collect_weather
    [ "$NEED_CUSTOM" = 1 ] && [ $((N % 5)) -eq 4 ] && collect_custom
    [ "$NEED_PATH" = 1 ] && [ $((N % 15)) -eq 3 ] && collect_path
    [ "$NEED_TALKERS" = 1 ] && [ $((N % 3)) -eq 0 ] && collect_talkers
    [ "$NEED_CHIMES" = 1 ] && [ $((N % 30)) -eq 0 ] && collect_chimes
    [ "$NEED_ANIMS" = 1 ] && [ $((N % 30)) -eq 5 ] && collect_anims
    [ "$ONCE" = 1 ] && [ "$N" -ge "$ONCE_N" ] && break
    N=$((N + 1))
    sleep 1
done
