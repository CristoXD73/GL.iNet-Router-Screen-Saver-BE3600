#!/bin/sh
#
# be3600-screensaver -- supervisor for the BE3600 animation screensaver.
#
# Exactly one of two things owns the small front display at any time:
#
#   STOCK   GL.iNet's gl_screen (the normal UI)
#   CUSTOM  be3600-player.lua, writing frames straight to /dev/fb0
#
#   STOCK --(IDLE_SECONDS with no touch)--> CUSTOM
#   CUSTOM --(swipe along the strip, or a single tap)--> slides to the next / previous
#                                                         saved animation (stays CUSTOM)
#   CUSTOM --(double-tap, or a swipe across the strip)--> STOCK
#
# With the native player all touch handling happens inside that one player process (it
# follows the finger, slides between animations, and exits with code 10 when the user
# dismisses it). The Lua player, or a native player that cannot open the touchscreen,
# uses the older scheme: small helper programs watch for touches and this script decides.
#
# Settings live in /etc/be3600-screen/config (shell syntax).

CONF="/etc/be3600-screen/config"
ANIMATION="/etc/be3600-screen/active.bea"
LIB="/etc/be3600-screen/animations"
IDLE_SECONDS=10
TOUCH_DEVICE=""          # empty = find the touchscreen automatically
DOUBLE_TAP_WINDOW_SECONDS=0.3   # a second tap within this long is a double-tap (exit);
                                 # a lone tap switches to the next saved animation instead
SLIDE_MS=280                    # how long a slide between animations takes (native player)
SWIPE_INVERT=0                  # 1 = swap which swipe direction goes to the next animation
TOUCH_LONG_AXIS=Y               # which touchscreen axis runs along the strip (X or Y)
SWITCH_FADE_MS=250              # crossfade time of a tap switch when the helper-based scheme is in use
LOCKDIR="/tmp/be3600-screen.lock"
SHOW_NOW="/tmp/be3600-screen.show-now"   # be3600-anim hello leaves this so the welcome runs straight into the screensaver
PLAYER="/usr/bin/be3600-player.lua"
NATIVE="/usr/bin/be3600-player"
PLAYER_ENGINE="auto"     # auto = the native player if installed, else Lua; "lua" forces Lua
TOUCH="/usr/bin/be3600-wait-touch.lua"
WIDGETD="/usr/bin/be3600-widgetd"
PAGES="animations"       # what can be swiped between: animations and live pages (see be3600-anim pages)

# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
export TOUCH_DEVICE

case "$SLIDE_MS" in ''|*[!0-9]*) SLIDE_MS=280 ;; esac

GESTURES=1               # the native player handles the touchscreen itself (set to 0 if it cannot)
ENGINE=""
PLAYER_PID=""
CLEANED=0
WARNED=0


log() {
    logger -t be3600-screen "$*"
    echo "[be3600] $*"
}


# True if the PID exists and is not a zombie. (kill -0 alone reports
# success for a zombie, so a crashed background job would look alive.)
#
# Reads /proc/PID/status with shell built-ins only (no grep to fork), because this
# is checked several times a second while an animation is showing.
alive() {
    [ -n "$1" ] || return 1

    ALIVE_STATE=""

    while read -r ALIVE_KEY ALIVE_VAL; do
        if [ "$ALIVE_KEY" = "State:" ]; then
            ALIVE_STATE="$ALIVE_VAL"
            break
        fi
    done 2>/dev/null < "/proc/$1/status"

    # Empty: the process is gone. Z...: a zombie (dead, not yet reaped).
    case "$ALIVE_STATE" in
        ''|Z*) return 1 ;;
    esac

    return 0
}


# True if the PID is alive AND really is a be3600-screensaver. A stale lock could
# otherwise point at a recycled PID that now belongs to some unrelated process.
is_supervisor() {
    alive "$1" &&
    tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q 'be3600-screensaver'
}


# ------------------------------------------------------------
# SINGLE SUPERVISOR ONLY
#
# mkdir is atomic, so two supervisors starting at the same moment cannot both
# win the way they could with a "check the PID file, then write it" scheme.
# ------------------------------------------------------------

acquire_lock() {

    if mkdir "$LOCKDIR" 2>/dev/null; then
        echo $$ > "$LOCKDIR/pid"
        return 0
    fi

    OLD="$(cat "$LOCKDIR/pid" 2>/dev/null)"

    if [ -z "$OLD" ]; then
        # The winner may not have written its PID yet; give it a moment.
        /bin/usleep 200000
        OLD="$(cat "$LOCKDIR/pid" 2>/dev/null)"
    fi

    if is_supervisor "$OLD"; then
        log "supervisor already running PID=$OLD"
        return 1
    fi

    # Stale lock: the previous supervisor died without cleaning up.
    rm -rf "$LOCKDIR"
    mkdir "$LOCKDIR" 2>/dev/null || return 1
    echo $$ > "$LOCKDIR/pid"
    return 0
}

acquire_lock || exit 1

# If something clears /tmp/be3600-screen.lock while we run, put it back so the
# single-supervisor guarantee (and be3600-anim status) keeps working.
refresh_lock() {
    [ -d "$LOCKDIR" ] && return 0
    mkdir "$LOCKDIR" 2>/dev/null && echo $$ > "$LOCKDIR/pid"
}


# ------------------------------------------------------------
# DISPLAY COMPATIBILITY GUARD
#
# The animation format is one raw 76x284, 16bpp, 152-byte-stride frame. If a
# firmware update changes the display layout, taking over /dev/fb0 would draw
# garbage, so in that case the stock screen is left alone.
# ------------------------------------------------------------

display_ok() {
    FB="/sys/class/graphics/fb0"
    [ "$(cat "$FB/virtual_size" 2>/dev/null)" = "76,284" ] &&
    [ "$(cat "$FB/bits_per_pixel" 2>/dev/null)" = "16" ] &&
    [ "$(cat "$FB/stride" 2>/dev/null)" = "152" ]
}


# ------------------------------------------------------------
# FIRMWARE-CHANGE PROBE
#
# The firmware version this was last verified on is remembered in
# /etc/be3600-screen/verified. When the firmware (or kernel) is different, for
# example after a sysupgrade that kept settings, the display and touchscreen are
# probed BEFORE the display is taken over. If the probe fails, the stock screen
# is left alone and the problem is logged. The probe is repeated every minute,
# so a later fix (or running the installer again) is picked up by itself.
# ------------------------------------------------------------

STAMP="/etc/be3600-screen/verified"

fingerprint() {
    echo "$(cat /etc/glversion 2>/dev/null || echo unknown-firmware) kernel-$(uname -r)"
}

# Prints why the probe failed (and returns 1), or prints nothing and returns 0.
probe() {
    display_ok || { echo "front display is not 76x284 / 16bpp / 152-byte stride"; return 1; }
    [ -x /etc/init.d/gl_screen ] || { echo "/etc/init.d/gl_screen is missing (the stock screen service moved?)"; return 1; }
    WHICH="$(/usr/bin/lua "$TOUCH" --which 2>/dev/null)"
    [ -r "${WHICH%% *}" ] || { echo "touch device not found (${WHICH:-none})"; return 1; }
    return 0
}

# 0 = safe to take over the display, 1 = leave the stock screen alone.
verify_firmware() {
    FP="$(fingerprint)"
    KNOWN="$(cat "$STAMP" 2>/dev/null)"

    if [ "$KNOWN" = "$FP" ]; then
        display_ok || { REASON="front display is not 76x284 / 16bpp / 152-byte stride"; return 1; }
        return 0
    fi

    if REASON="$(probe)"; then
        [ -n "$KNOWN" ] && log "firmware changed ($KNOWN -> $FP); compatibility probe passed"
        mkdir -p "$(dirname "$STAMP")"
        echo "$FP" > "$STAMP.new" && mv "$STAMP.new" "$STAMP"
        return 0
    fi

    return 1
}


# ------------------------------------------------------------
# THE HELPER FOR THE LIVE PAGES
#
# Some pages (internet, Wi-Fi clients, VPN, weather, ...) need data that be3600-widgetd collects. It runs only
# while the animation/pages are on screen, and only if PAGES lists a page that needs it.
# ------------------------------------------------------------

needs_helper() {
    for PG in $PAGES; do
        case "$PG" in
            animations|anim:*|clock|analog|aurora|netspeed|vitals|info|usage|pomodoro|stopwatch|message) ;;
            *) return 0 ;;
        esac
    done
    return 1
}

WIDGETD_PID=""

start_widgetd() {
    needs_helper || return 0
    [ -x "$WIDGETD" ] || return 0
    alive "$WIDGETD_PID" && return 0
    "$WIDGETD" >/dev/null 2>&1 &
    WIDGETD_PID=$!
}

stop_widgetd() {
    if [ -n "$WIDGETD_PID" ]; then
        kill "$WIDGETD_PID" 2>/dev/null || true
        wait "$WIDGETD_PID" 2>/dev/null || true
        WIDGETD_PID=""
    fi
    for PID in $(ps w | grep '[b]e3600-widgetd' | awk '{print $1}'); do
        kill "$PID" 2>/dev/null || true
    done
}


# ------------------------------------------------------------
# PROCESS CONTROL
# ------------------------------------------------------------

kill_custom() {

    if [ -n "$PLAYER_PID" ]; then
        kill "$PLAYER_PID" 2>/dev/null || true
        wait "$PLAYER_PID" 2>/dev/null || true
        PLAYER_PID=""
    fi

    for PID in $(ps w | grep '[b]e3600-player' | awk '{print $1}'); do
        kill "$PID" 2>/dev/null || true
    done

    # Brief grace period for any stray player we didn't have a tracked PID for
    # (the normal, tracked PLAYER_PID was already waited for above).
    /bin/usleep 50000

    for PID in $(ps w | grep '[b]e3600-player' | awk '{print $1}'); do
        kill -9 "$PID" 2>/dev/null || true
    done
}


kill_touch() {
    for PID in $(ps w | grep '[b]e3600-wait-touch.lua' | awk '{print $1}'); do
        kill "$PID" 2>/dev/null || true
    done
}


stop_stock() {

    /etc/init.d/gl_screen stop >/dev/null 2>&1 || true

    COUNT=0

    while ps w | grep -q '[g]l_screen'; do

        COUNT=$((COUNT+1))

        if [ "$COUNT" -ge 20 ]; then
            for PID in $(ps w | grep '[g]l_screen' | awk '{print $1}'); do
                kill -9 "$PID" 2>/dev/null || true
            done
            break
        fi

        /bin/usleep 100000
    done
}


# ------------------------------------------------------------
# DISPLAY OWNERSHIP
# ------------------------------------------------------------

start_stock() {

    # Custom must die FIRST so the two never fight over the framebuffer.
    kill_custom
    stop_widgetd

    # Never leave two GL.iNet instances running.
    stop_stock

    /etc/init.d/gl_screen start >/dev/null 2>&1 || true

    log "OWNER = GL.iNet"
}


# DOUBLE_TAP_WINDOW_SECONDS (may have a decimal point) in whole milliseconds, for the player.
double_tap_ms() {
    case "$DOUBLE_TAP_WINDOW_SECONDS" in
        ''|*[!0-9.]*|*.*.*) echo 300; return ;;
    esac
    awk -v s="$DOUBLE_TAP_WINDOW_SECONDS" 'BEGIN { printf "%d\n", s * 1000 }'
}


start_custom() {

    # $1 (optional): milliseconds to crossfade in over, native player only.
    # Used for a tap-triggered switch; a cold start from idle omits it.
    FADE_MS="$1"

    kill_custom

    # GL.iNet must fully release the framebuffer first.
    stop_stock

    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true

    # The native player is preferred (exact timing, almost no CPU); the Lua
    # player is the fallback and does not support --fade. PLAYER_ENGINE=lua in
    # the config forces Lua.
    if [ "$PLAYER_ENGINE" != "lua" ] && [ -x "$NATIVE" ]; then
        ENGINE="native"
        if [ "$GESTURES" = 1 ]; then
            set -- --gestures --lib "$LIB" --slide "$SLIDE_MS" --double-tap "$(double_tap_ms)"
            [ "$SWIPE_INVERT" = 1 ] && set -- "$@" --swipe-invert
            case "$TOUCH_LONG_AXIS" in X|x|Y|y) set -- "$@" --long-axis "$TOUCH_LONG_AXIS" ;; esac
            "$NATIVE" "$@" "$ANIMATION" >/tmp/be3600-player.log 2>&1 &
        elif [ -n "$FADE_MS" ]; then
            "$NATIVE" --fade "$FADE_MS" "$ANIMATION" >/tmp/be3600-player.log 2>&1 &
        else
            "$NATIVE" "$ANIMATION" >/tmp/be3600-player.log 2>&1 &
        fi
    else
        ENGINE="lua"
        /usr/bin/lua "$PLAYER" "$ANIMATION" >/tmp/be3600-player.log 2>&1 &
    fi

    PLAYER_PID=$!

    /bin/usleep 70000

    if ! alive "$PLAYER_PID"; then
        log "ERROR: animation failed to start (see /tmp/be3600-player.log)"
        start_stock
        return 1
    fi

    log "OWNER = CUSTOM PID=$PLAYER_PID ($ENGINE player)"
    [ "$ENGINE" = "native" ] && start_widgetd

    return 0
}


# ------------------------------------------------------------
# SWITCHING BETWEEN SAVED ANIMATIONS
#
# The library ($LIB) holds up to a few named .bea files (see be3600-anim set /
# list / use). A single tap while an animation is showing steps to the next one
# in the library, in a fixed round-robin order, without leaving CUSTOM.
# ------------------------------------------------------------

# Prints the library file that should play after the one now active, in a fixed
# order, wrapping around. Prints nothing (and fails) if there are fewer than two
# usable animations to choose between.
next_library_animation() {

    FILES=""

    for F in "$LIB"/*.bea; do
        [ -f "$F" ] && FILES="$FILES $F"
    done

    # shellcheck disable=SC2086  # deliberate word-splitting of a list we just built
    set -- $FILES

    [ "$#" -ge 2 ] || return 1

    CUR=0
    i=1

    for F in "$@"; do
        cmp -s "$F" "$ANIMATION" && CUR=$i
        i=$((i + 1))
    done

    NEXT=$(( CUR % $# + 1 ))

    i=1

    for F in "$@"; do
        if [ "$i" -eq "$NEXT" ]; then
            echo "$F"
            return 0
        fi
        i=$((i + 1))
    done

    return 1
}

rotate_animation() {

    NEXTFILE="$(next_library_animation)"

    if [ -z "$NEXTFILE" ]; then
        log "tap: only one saved animation (or none); nothing to switch to"
        return 0
    fi

    if ! cp "$NEXTFILE" "$ANIMATION.new" || ! mv "$ANIMATION.new" "$ANIMATION"; then
        log "tap: could not switch animation"
        return 1
    fi

    log "tap: switched to $(basename "$NEXTFILE" .bea)"

    start_custom "$SWITCH_FADE_MS"
}


# ------------------------------------------------------------
# WAIT FOR IDLE (stock owns the display)
#
# Returns once IDLE_SECONDS pass with no finger-down. Any touch
# restarts the timer. IDLE_SECONDS=0 means "don't wait".
# ------------------------------------------------------------

wait_for_idle() {

    [ "$IDLE_SECONDS" -gt 0 ] 2>/dev/null || return 0

    while :; do

        # Background + wait so a stop signal is handled immediately.
        timeout "$IDLE_SECONDS" /usr/bin/lua "$TOUCH" >/dev/null 2>&1 &
        wait $!
        RC=$?

        if [ "$RC" -eq 0 ]; then
            log "touch - idle timer reset"
            continue
        fi

        # 124 / 143: timeout ended the helper -> nobody touched for
        # IDLE_SECONDS.
        if [ "$RC" -eq 124 ] || [ "$RC" -eq 143 ]; then
            log "${IDLE_SECONDS}s idle"
            return 0
        fi

        # Anything else means the helper itself failed. Don't spin:
        # wait out the interval, then treat it as idle.
        log "touch helper failed (RC=$RC); treating as idle after ${IDLE_SECONDS}s"
        sleep "$IDLE_SECONDS"
        return 0
    done
}


# ------------------------------------------------------------
# ANIMATION RUNNING (custom owns the display)
#
# Returns 0 on a double-tap (leave to stock), 1 if the player keeps crashing.
# A single tap switches to the next saved animation and keeps running.
# Also restarts the player if it dies (up to 3 times).
# ------------------------------------------------------------

# True (0) if a second tap arrives within DOUBLE_TAP_WINDOW_SECONDS; false
# (1) if that time passes with nothing, or the helper itself fails.
# DOUBLE_TAP_WINDOW_SECONDS may have a decimal point (this router's "timeout"
# accepts fractional seconds); reject anything that isn't a plain non-negative
# number, with or without one decimal point, and fall back to a safe default.
second_tap_follows() {
    SECS="$DOUBLE_TAP_WINDOW_SECONDS"
    case "$SECS" in
        ''|*[!0-9.]*|*.*.*) SECS=0.4 ;;
    esac

    timeout "$SECS" /usr/bin/lua "$TOUCH" >/dev/null 2>&1 &
    wait $!
}

# The native player does all the touch handling itself; this only waits for it.
run_native() {

    RESTARTS=0

    while :; do

        POLLS=0
        while alive "$PLAYER_PID"; do
            POLLS=$((POLLS + 1))
            [ $((POLLS % 10)) -eq 0 ] && refresh_lock
            /bin/usleep 100000
        done

        wait "$PLAYER_PID" 2>/dev/null
        RC=$?
        PLAYER_PID=""

        case "$RC" in
            10)
                log "dismissed by touch: leaving the animation"
                return 0
                ;;
            11)
                log "the player could not use the touchscreen; using the helper programs instead"
                GESTURES=0
                start_custom || return 1
                run_animation
                return $?
                ;;
        esac

        RESTARTS=$((RESTARTS+1))

        log "player exited RC=$RC (see /tmp/be3600-player.log), restart $RESTARTS/3"

        if [ "$RESTARTS" -gt 3 ]; then
            log "player keeps dying; giving up, returning to stock"
            return 1
        fi

        start_custom || return 1
    done
}


run_animation() {

    if [ "$ENGINE" = "native" ] && [ "$GESTURES" = 1 ]; then
        run_native
        return $?
    fi

    RESTARTS=0

    while :; do

        /usr/bin/lua "$TOUCH" >/dev/null 2>&1 &
        TOUCH_PID=$!

        # Watch both processes: the touch helper (exits on a touch)
        # and the player (should never exit). Polled quickly (10/s) so a tap
        # is noticed right away; refresh_lock is cheap enough to afford that.
        POLLS=0
        while alive "$TOUCH_PID" && alive "$PLAYER_PID"; do
            POLLS=$((POLLS + 1))
            [ $((POLLS % 10)) -eq 0 ] && refresh_lock
            /bin/usleep 100000
        done

        if alive "$TOUCH_PID"; then

            # We left the loop because the player died.
            kill "$TOUCH_PID" 2>/dev/null || true
            wait "$TOUCH_PID" 2>/dev/null || true

            RESTARTS=$((RESTARTS+1))

            log "player died (see /tmp/be3600-player.log), restart $RESTARTS/3"

            if [ "$RESTARTS" -gt 3 ]; then
                log "player keeps dying; giving up, returning to stock"
                return 1
            fi

            start_custom || return 1

            continue
        fi

        wait "$TOUCH_PID"
        RC=$?

        if [ "$RC" -eq 0 ]; then

            # Wait for the finger to actually lift before timing a possible
            # second tap. A real tap is not instantaneous, and while it stays
            # down the same contact would otherwise look like a second one.
            # Capped in case a release is ever not reported cleanly.
            timeout 2 /usr/bin/lua "$TOUCH" --wait-release >/dev/null 2>&1 &
            wait $!

            if second_tap_follows; then
                log "double-tap: leaving the animation"
                return 0
            fi

            rotate_animation
            continue
        fi

        log "touch helper exited RC=$RC; retrying"
        sleep 1
    done
}


# ------------------------------------------------------------
# CLEAN EXIT
# ------------------------------------------------------------

cleanup() {

    [ "$CLEANED" = 1 ] && return
    CLEANED=1

    log "supervisor stopping"

    kill_touch
    start_stock

    rm -rf "$LOCKDIR"
}

trap 'cleanup; exit 0' INT TERM HUP
trap cleanup EXIT


# ------------------------------------------------------------
# MAIN LOOP
# ------------------------------------------------------------

start_stock

TOUCH_NAME="$(/usr/bin/lua "$TOUCH" --which 2>/dev/null)"
log "touchscreen: ${TOUCH_NAME:-unknown}"

while :; do

    refresh_lock

    REASON=""
    if ! verify_firmware; then
        if [ "$WARNED" != 1 ]; then
            log "compatibility probe failed: $REASON; leaving the stock screen alone (checking again every minute)"
            WARNED=1
        fi
        sleep 60
        continue
    fi
    WARNED=0

    # The welcome has just had the screen and handed it straight here; going back to the stock
    # screen for the idle countdown first would undo the moment.
    if [ -f "$SHOW_NOW" ]; then
        rm -f "$SHOW_NOW"
        log "showing at once (the welcome asked for it)"
    else
        wait_for_idle
    fi

    if start_custom; then

        run_animation

        kill_touch
        start_stock

        /bin/usleep 350000

    else

        # start_custom already put stock back; don't spin.
        sleep 5
    fi

done
