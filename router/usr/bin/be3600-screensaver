#!/bin/sh
#
# be3600-screensaver -- supervisor for the BE3600 animation screensaver.
#
# Exactly one of two things owns the small front display at any time:
#
#   STOCK   GL.iNet's gl_screen (the normal UI)
#   CUSTOM  be3600-player.lua, writing frames straight to /dev/fb0
#
#   STOCK --(IDLE_SECONDS with no touch)--> CUSTOM
#   CUSTOM --(a finger touches the screen)--> STOCK
#
# Settings live in /etc/be3600-screen/config (shell syntax).

CONF="/etc/be3600-screen/config"
ANIMATION="/etc/be3600-screen/active.bea"
IDLE_SECONDS=10
TOUCH_DEVICE=""          # empty = find the touchscreen automatically
LOCKDIR="/tmp/be3600-screen.lock"
PLAYER="/usr/bin/be3600-player.lua"
NATIVE="/usr/bin/be3600-player"
PLAYER_ENGINE="auto"     # auto = the native player if installed, else Lua; "lua" forces Lua
TOUCH="/usr/bin/be3600-wait-touch.lua"

# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
export TOUCH_DEVICE

PLAYER_PID=""
CLEANED=0
WARNED=0


log() {
    logger -t be3600-screen "$*"
    echo "[be3600] $*"
}


# True if the PID exists and is not a zombie. (kill -0 alone reports
# success for a zombie, so a crashed background job would look alive.)
alive() {
    [ -n "$1" ] &&
    [ -r "/proc/$1/status" ] &&
    ! grep -q '^State:[[:space:]]*Z' "/proc/$1/status" 2>/dev/null
}


# True if the PID is alive AND really is a be3600-screensaver. A stale lock could
# otherwise point at a recycled PID that now belongs to some unrelated process.
is_supervisor() {
    alive "$1" &&
    tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q 'be3600-screensaver'
}


# ------------------------------------------------------------
# SINGLE SUPERVISOR ONLY
#
# mkdir is atomic, so two supervisors starting at the same moment cannot both
# win the way they could with a "check the PID file, then write it" scheme.
# ------------------------------------------------------------

acquire_lock() {

    if mkdir "$LOCKDIR" 2>/dev/null; then
        echo $$ > "$LOCKDIR/pid"
        return 0
    fi

    OLD="$(cat "$LOCKDIR/pid" 2>/dev/null)"

    if [ -z "$OLD" ]; then
        # The winner may not have written its PID yet; give it a moment.
        /bin/usleep 200000
        OLD="$(cat "$LOCKDIR/pid" 2>/dev/null)"
    fi

    if is_supervisor "$OLD"; then
        log "supervisor already running PID=$OLD"
        return 1
    fi

    # Stale lock: the previous supervisor died without cleaning up.
    rm -rf "$LOCKDIR"
    mkdir "$LOCKDIR" 2>/dev/null || return 1
    echo $$ > "$LOCKDIR/pid"
    return 0
}

acquire_lock || exit 1

# If something clears /tmp/be3600-screen.lock while we run, put it back so the
# single-supervisor guarantee (and be3600-anim status) keeps working.
refresh_lock() {
    [ -d "$LOCKDIR" ] && return 0
    mkdir "$LOCKDIR" 2>/dev/null && echo $$ > "$LOCKDIR/pid"
}


# ------------------------------------------------------------
# DISPLAY COMPATIBILITY GUARD
#
# The animation format is one raw 76x284, 16bpp, 152-byte-stride frame. If a
# firmware update changes the display layout, taking over /dev/fb0 would draw
# garbage, so in that case the stock screen is left alone.
# ------------------------------------------------------------

display_ok() {
    FB="/sys/class/graphics/fb0"
    [ "$(cat "$FB/virtual_size" 2>/dev/null)" = "76,284" ] &&
    [ "$(cat "$FB/bits_per_pixel" 2>/dev/null)" = "16" ] &&
    [ "$(cat "$FB/stride" 2>/dev/null)" = "152" ]
}


# ------------------------------------------------------------
# FIRMWARE-CHANGE PROBE
#
# The firmware version this was last verified on is remembered in
# /etc/be3600-screen/verified. When the firmware (or kernel) is different, for
# example after a sysupgrade that kept settings, the display and touchscreen are
# probed BEFORE the display is taken over. If the probe fails, the stock screen
# is left alone and the problem is logged. The probe is repeated every minute,
# so a later fix (or running the installer again) is picked up by itself.
# ------------------------------------------------------------

STAMP="/etc/be3600-screen/verified"

fingerprint() {
    echo "$(cat /etc/glversion 2>/dev/null || echo unknown-firmware) kernel-$(uname -r)"
}

# Prints why the probe failed (and returns 1), or prints nothing and returns 0.
probe() {
    display_ok || { echo "front display is not 76x284 / 16bpp / 152-byte stride"; return 1; }
    [ -x /etc/init.d/gl_screen ] || { echo "/etc/init.d/gl_screen is missing (the stock screen service moved?)"; return 1; }
    WHICH="$(/usr/bin/lua "$TOUCH" --which 2>/dev/null)"
    [ -r "${WHICH%% *}" ] || { echo "touch device not found (${WHICH:-none})"; return 1; }
    return 0
}

# 0 = safe to take over the display, 1 = leave the stock screen alone.
verify_firmware() {
    FP="$(fingerprint)"
    KNOWN="$(cat "$STAMP" 2>/dev/null)"

    if [ "$KNOWN" = "$FP" ]; then
        display_ok || { REASON="front display is not 76x284 / 16bpp / 152-byte stride"; return 1; }
        return 0
    fi

    if REASON="$(probe)"; then
        [ -n "$KNOWN" ] && log "firmware changed ($KNOWN -> $FP); compatibility probe passed"
        mkdir -p "$(dirname "$STAMP")"
        echo "$FP" > "$STAMP.new" && mv "$STAMP.new" "$STAMP"
        return 0
    fi

    return 1
}


# ------------------------------------------------------------
# PROCESS CONTROL
# ------------------------------------------------------------

kill_custom() {

    if [ -n "$PLAYER_PID" ]; then
        kill "$PLAYER_PID" 2>/dev/null || true
        wait "$PLAYER_PID" 2>/dev/null || true
        PLAYER_PID=""
    fi

    for PID in $(ps w | grep '[b]e3600-player' | awk '{print $1}'); do
        kill "$PID" 2>/dev/null || true
    done

    /bin/usleep 150000

    for PID in $(ps w | grep '[b]e3600-player' | awk '{print $1}'); do
        kill -9 "$PID" 2>/dev/null || true
    done
}


kill_touch() {
    for PID in $(ps w | grep '[b]e3600-wait-touch.lua' | awk '{print $1}'); do
        kill "$PID" 2>/dev/null || true
    done
}


stop_stock() {

    /etc/init.d/gl_screen stop >/dev/null 2>&1 || true

    COUNT=0

    while ps w | grep -q '[g]l_screen'; do

        COUNT=$((COUNT+1))

        if [ "$COUNT" -ge 20 ]; then
            for PID in $(ps w | grep '[g]l_screen' | awk '{print $1}'); do
                kill -9 "$PID" 2>/dev/null || true
            done
            break
        fi

        /bin/usleep 100000
    done
}


# ------------------------------------------------------------
# DISPLAY OWNERSHIP
# ------------------------------------------------------------

start_stock() {

    # Custom must die FIRST so the two never fight over the framebuffer.
    kill_custom

    # Never leave two GL.iNet instances running.
    stop_stock

    /etc/init.d/gl_screen start >/dev/null 2>&1 || true

    log "OWNER = GL.iNet"
}


start_custom() {

    kill_custom

    # GL.iNet must fully release the framebuffer first.
    stop_stock

    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true

    # The native player is preferred (exact timing, almost no CPU); the Lua
    # player is the fallback. PLAYER_ENGINE=lua in the config forces Lua.
    if [ "$PLAYER_ENGINE" != "lua" ] && [ -x "$NATIVE" ]; then
        ENGINE="native"
        "$NATIVE" "$ANIMATION" >/tmp/be3600-player.log 2>&1 &
    else
        ENGINE="lua"
        /usr/bin/lua "$PLAYER" "$ANIMATION" >/tmp/be3600-player.log 2>&1 &
    fi

    PLAYER_PID=$!

    /bin/usleep 200000

    if ! alive "$PLAYER_PID"; then
        log "ERROR: animation failed to start (see /tmp/be3600-player.log)"
        start_stock
        return 1
    fi

    log "OWNER = CUSTOM PID=$PLAYER_PID ($ENGINE player)"

    return 0
}


# ------------------------------------------------------------
# WAIT FOR IDLE (stock owns the display)
#
# Returns once IDLE_SECONDS pass with no finger-down. Any touch
# restarts the timer. IDLE_SECONDS=0 means "don't wait".
# ------------------------------------------------------------

wait_for_idle() {

    [ "$IDLE_SECONDS" -gt 0 ] 2>/dev/null || return 0

    while :; do

        # Background + wait so a stop signal is handled immediately.
        timeout "$IDLE_SECONDS" /usr/bin/lua "$TOUCH" >/dev/null 2>&1 &
        wait $!
        RC=$?

        if [ "$RC" -eq 0 ]; then
            log "touch - idle timer reset"
            continue
        fi

        # 124 / 143: timeout ended the helper -> nobody touched for
        # IDLE_SECONDS.
        if [ "$RC" -eq 124 ] || [ "$RC" -eq 143 ]; then
            log "${IDLE_SECONDS}s idle"
            return 0
        fi

        # Anything else means the helper itself failed. Don't spin:
        # wait out the interval, then treat it as idle.
        log "touch helper failed (RC=$RC); treating as idle after ${IDLE_SECONDS}s"
        sleep "$IDLE_SECONDS"
        return 0
    done
}


# ------------------------------------------------------------
# ANIMATION RUNNING (custom owns the display)
#
# Returns 0 on a real touch, 1 if the player keeps crashing.
# Also restarts the player if it dies (up to 3 times).
# ------------------------------------------------------------

run_animation() {

    RESTARTS=0

    while :; do

        /usr/bin/lua "$TOUCH" >/dev/null 2>&1 &
        TOUCH_PID=$!

        # Watch both processes: the touch helper (exits on a touch)
        # and the player (should never exit).
        while alive "$TOUCH_PID" && alive "$PLAYER_PID"; do
            refresh_lock
            sleep 1
        done

        if alive "$TOUCH_PID"; then

            # We left the loop because the player died.
            kill "$TOUCH_PID" 2>/dev/null || true
            wait "$TOUCH_PID" 2>/dev/null || true

            RESTARTS=$((RESTARTS+1))

            log "player died (see /tmp/be3600-player.log), restart $RESTARTS/3"

            if [ "$RESTARTS" -gt 3 ]; then
                log "player keeps dying; giving up, returning to stock"
                return 1
            fi

            start_custom || return 1

            continue
        fi

        wait "$TOUCH_PID"
        RC=$?

        if [ "$RC" -eq 0 ]; then
            log "touch while animation active"
            return 0
        fi

        log "touch helper exited RC=$RC; retrying"
        sleep 1
    done
}


# ------------------------------------------------------------
# CLEAN EXIT
# ------------------------------------------------------------

cleanup() {

    [ "$CLEANED" = 1 ] && return
    CLEANED=1

    log "supervisor stopping"

    kill_touch
    start_stock

    rm -rf "$LOCKDIR"
}

trap 'cleanup; exit 0' INT TERM HUP
trap cleanup EXIT


# ------------------------------------------------------------
# MAIN LOOP
# ------------------------------------------------------------

start_stock

TOUCH_NAME="$(/usr/bin/lua "$TOUCH" --which 2>/dev/null)"
log "touchscreen: ${TOUCH_NAME:-unknown}"

while :; do

    refresh_lock

    REASON=""
    if ! verify_firmware; then
        if [ "$WARNED" != 1 ]; then
            log "compatibility probe failed: $REASON; leaving the stock screen alone (checking again every minute)"
            WARNED=1
        fi
        sleep 60
        continue
    fi
    WARNED=0

    wait_for_idle

    if start_custom; then

        run_animation

        kill_touch
        start_stock

        /bin/usleep 350000

    else

        # start_custom already put stock back; don't spin.
        sleep 5
    fi

done
