#!/bin/sh
#
# be3600-anim -- control the BE3600 animation screensaver.
#
#   be3600-anim on            enable at boot and start now
#   be3600-anim off           stop, restore the stock screen, disable at boot
#   be3600-anim status        show what is running
#   be3600-anim set FILE.bea [NAME]
#                             validate FILE, keep it in the library and play it
#   be3600-anim list          the animations in the library (* = playing now)
#                             (--plain: tab-separated, for programs)
#   be3600-anim use NAME      play a library animation
#   be3600-anim remove NAME   delete a library animation
#   be3600-anim check         validate the active animation and show its length
#   be3600-anim doctor        check the display, touchscreen, animation and service
#   be3600-anim preview [FILE.bea] [SECONDS]
#                             play FILE (default: the active one) for SECONDS (default 10),
#                             then restore everything; installs nothing
#   be3600-anim pages         the pages you can swipe between (animations and live pages)
#   be3600-anim pages set "animations clock netspeed"
#                             choose which pages, in which order (also: add NAME, remove NAME, reset)
#   be3600-anim say "text" [red|green|yellow|cyan|orange]
#                             put a message on the message page (say --clear removes it)
#   be3600-anim alert "text" [info|good|warn|bad]
#                             show a banner on the screen now
#   be3600-anim chime [NAME]  play a chime on the cooling fan (no NAME lists them)
#   be3600-anim hello         the welcome: the eyes wake up while the fan revs

SVC="/etc/init.d/be3600-screensaver"
BEA="/etc/be3600-screen/active.bea"
CHECK="/usr/bin/be3600-bea-check.lua"
TOUCH="/usr/bin/be3600-wait-touch.lua"
LOCKDIR="/tmp/be3600-screen.lock"
LIB="/etc/be3600-screen/animations"
CONF="/etc/be3600-screen/config"
MSG="/etc/be3600-screen/message"
FAN="/usr/sbin/be3600-fan"
DATA="/tmp/be3600-widgets"
RESERVE_KB=20480          # always leave this much free on the router
MAX_ANIMS=3               # the library holds at most this many animations
MAX_LOOP_S=25             # and none may loop for longer than this many seconds

# conf_get and conf_set, shared with the other scripts.
COMMON="$(dirname "$0")/../lib/be3600/common.sh"
[ -r "$COMMON" ] || COMMON="/usr/lib/be3600/common.sh"
# shellcheck source=router/usr/lib/be3600/common.sh
. "$COMMON"

usage() {
    sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
}

# True if the supervisor is running: the PID in its lock must be alive AND really
# be a be3600-screensaver (a stale lock could point at a recycled PID).
running() {
    P="$(cat "$LOCKDIR/pid" 2>/dev/null)"
    [ -n "$P" ] &&
    [ -r "/proc/$P/cmdline" ] &&
    tr '\0' ' ' < "/proc/$P/cmdline" 2>/dev/null | grep -q 'be3600-screensaver'
}

count() { ps w | grep -c "$1"; }

# ---- the animation library --------------------------------------------------
# Every animation you set is kept in $LIB by name, so you can switch back to it
# later. The one being replaced is saved as "previous" first, so nothing is lost.

safe_name() {   # letters, digits . _ - only, no .bea suffix, at most 40 characters
    N="${1%.bea}"
    N="${N%.BEA}"
    printf '%s' "$N" | sed 's/[^A-Za-z0-9._-]/-/g' | cut -c1-40
}

# shellcheck disable=SC2012  # BusyBox on the router has no reliable stat; ls -l is fine here
file_bytes() { ls -l "$1" 2>/dev/null | awk '{print $5}'; }
free_kb() { df -k /overlay 2>/dev/null | tail -n 1 | awk '{print $4}'; }

lib_count() {
    N=0
    for F in "$LIB"/*.bea; do
        [ -f "$F" ] && N=$((N + 1))
    done
    echo "$N"
}

# Validate $1 like "check", and also refuse a loop longer than MAX_LOOP_S seconds.
loop_ok() {
    OUT="$(lua "$CHECK" "$1")" || return 1
    TICKS="$(echo "$OUT" | sed 's/.*frames, \([0-9]*\) ticks at.*/\1/')"
    FPS="$(echo "$OUT" | sed 's/.*ticks at \([0-9]*\) fps.*/\1/')"
    if [ "$TICKS" -gt $((MAX_LOOP_S * FPS)) ]; then
        echo "INVALID: this animation loops for $(awk "BEGIN { printf \"%.1f\", $TICKS / $FPS }") s; the limit is $MAX_LOOP_S s." >&2
        return 1
    fi
    echo "$OUT"
}

in_library() {   # true if some library file is byte-identical to $1
    for F in "$LIB"/*.bea; do
        [ -f "$F" ] && cmp -s "$F" "$1" && return 0
    done
    return 1
}

activate() {   # make $1 the animation that plays, and pick it up now if running
    cp "$1" "$BEA.new" && mv "$BEA.new" "$BEA" || return 1
    rm -f "$DATA/page"                        # show this animation, not the page that was showing before
    if running; then
        "$SVC" restart
        echo "restarted the screensaver to pick it up."
    fi
}

# The same list for programs (Motion Studio's Studio Link reads it): one tab-separated
# line per animation,  * or -  (playing or not)  NAME  BYTES  SECONDS ,  then one
# "limits" line with the most animations and the longest loop allowed. Stable on purpose.
lib_plain() {
    for F in "$LIB"/*.bea; do
        [ -f "$F" ] || continue
        MARK="-"
        cmp -s "$F" "$BEA" && MARK="*"
        SECS="$(lua "$CHECK" "$F" 2>/dev/null | sed 's/.*= \([0-9.]*\) s per loop.*/\1/')"
        printf '%s\t%s\t%s\t%s\n' "$MARK" "$(basename "$F" .bea)" "$(file_bytes "$F")" "${SECS:-0}"
    done
    printf 'limits\t%s\t%s\n' "$MAX_ANIMS" "$MAX_LOOP_S"
}

lib_list() {
    if ! ls "$LIB"/*.bea >/dev/null 2>&1; then
        echo "(the library is empty; add one with: be3600-anim set FILE.bea)"
        return 0
    fi
    for F in "$LIB"/*.bea; do
        NAME="$(basename "$F" .bea)"
        MARK=" "
        cmp -s "$F" "$BEA" && MARK="*"
        LEN="$(lua "$CHECK" "$F" 2>/dev/null | sed 's/.*= \(.*\) per loop.*/\1/')"
        printf '%s %-24s %6s KB   %s\n' "$MARK" "$NAME" "$(( ($(file_bytes "$F") + 1023) / 1024 ))" "${LEN:-invalid}"
    done
}

doctor() {

    FAILS=0
    WARNS=0
    ok()   { printf '  [ ok ] %s\n' "$*"; }
    warn() { printf '  [warn] %s\n' "$*"; WARNS=$((WARNS+1)); }
    bad()  { printf '  [FAIL] %s\n' "$*"; FAILS=$((FAILS+1)); }
    info() { printf '         %s\n' "$*"; }

    echo "be3600-anim doctor"

    echo
    echo "Router"
    MODEL="$(cat /tmp/sysinfo/model 2>/dev/null)"
    ok "model: ${MODEL:-unknown}"
    FP="$(cat /etc/glversion 2>/dev/null || echo unknown-firmware) kernel-$(uname -r)"
    ok "firmware: $FP"
    KNOWN="$(cat /etc/be3600-screen/verified 2>/dev/null)"
    if [ "$KNOWN" = "$FP" ]; then
        ok "this firmware has passed the compatibility probe"
    elif [ -z "$KNOWN" ]; then
        warn "not verified yet (the supervisor probes the display on its next start)"
    else
        warn "firmware changed since it was last verified ($KNOWN); the supervisor re-probes on its own"
    fi

    echo
    echo "Display"
    FB="/sys/class/graphics/fb0"
    if [ ! -e /dev/fb0 ]; then
        bad "/dev/fb0 does not exist"
    else
        NAME="$(cat "$FB/name" 2>/dev/null)"
        VSIZE="$(cat "$FB/virtual_size" 2>/dev/null)"
        BPP="$(cat "$FB/bits_per_pixel" 2>/dev/null)"
        STRIDE="$(cat "$FB/stride" 2>/dev/null)"
        MODES="$(head -n 1 "$FB/modes" 2>/dev/null)"
        info "driver $NAME, virtual $VSIZE, ${BPP}bpp, stride $STRIDE, mode $MODES"
        if [ "$VSIZE" = "76,284" ] && [ "$BPP" = "16" ] && [ "$STRIDE" = "152" ]; then
            ok "layout matches the .bea frame format (76x284, 16bpp, 152-byte stride = 43168 bytes)"
        else
            bad "layout is NOT 76x284 / 16bpp / stride 152; the supervisor will leave the stock screen alone"
        fi
        VH="${VSIZE#*,}"
        case "$MODES" in *x"$VH"*) info "virtual height equals visible height: no spare rows, so hardware page-flipping is unavailable (tearing cannot be avoided by flipping)" ;; esac
    fi

    echo
    echo "Touchscreen"
    WHICH="$(lua "$TOUCH" --which 2>&1)"
    DEV="${WHICH%% *}"
    if [ -e "$DEV" ]; then
        N="${DEV##*event}"
        ok "$WHICH: $(cat "/sys/class/input/event$N/device/name" 2>/dev/null)"
    else
        bad "touch device not found ($WHICH)"
    fi

    echo
    echo "Player"
    ok "$(lua -v 2>&1 | head -n 1) (fallback player)"
    if [ -x /usr/bin/be3600-player ]; then
        if V="$(/usr/bin/be3600-player --version 2>&1)"; then
            ok "native player: $V"
        else
            bad "the native player is installed but does not run: $V"
        fi
    else
        info "native player: not installed (the Lua player is used)"
    fi

    echo
    echo "Animation"
    if [ -f "$BEA" ]; then
        if OUT="$(lua "$CHECK" "$BEA" 2>&1)"; then ok "${OUT#OK }"; else bad "$OUT"; fi
    else
        bad "no animation at $BEA"
    fi

    echo
    echo "Service"
    if "$SVC" enabled 2>/dev/null; then ok "enabled at boot"; else warn "not enabled at boot (be3600-anim on)"; fi
    SUP="$(count '[b]e3600-screensaver')"
    if running; then
        if [ "$SUP" -eq 1 ]; then ok "supervisor running, PID $(cat "$LOCKDIR/pid")"; else bad "$SUP supervisor processes (expected exactly 1)"; fi
    else
        warn "supervisor is not running"
    fi

    echo
    echo "Display owners (exactly one should be drawing)"
    GL="$(count '[g]l_screen')"
    PL="$(count '[b]e3600-player')"
    info "gl_screen processes: $GL   custom player processes: $PL"
    if [ "$GL" -gt 0 ] && [ "$PL" -gt 0 ]; then
        bad "BOTH the stock screen and the animation are running (should never overlap); run: be3600-anim off && be3600-anim on"
    elif [ "$GL" -eq 0 ] && [ "$PL" -eq 0 ]; then
        warn "nothing is drawing to the display right now (fine for a second during a hand-over)"
    elif [ "$PL" -gt 0 ]; then
        ok "the animation owns the display"
    else
        ok "the stock GL.iNet screen owns the display"
    fi

    echo
    echo "Library"
    ok "$(lib_count) of $MAX_ANIMS animations saved (each may loop up to $MAX_LOOP_S s)"
    for F in "$LIB"/*.bea; do
        [ -f "$F" ] || continue
        OUT="$(loop_ok "$F" 2>&1)" || bad "$(basename "$F"): ${OUT#INVALID: }"
    done

    echo
    echo "Storage"
    for D in /overlay /tmp; do
        LINE="$(df -h "$D" 2>/dev/null | tail -n 1)"
        [ -n "$LINE" ] && info "$D: $(echo "$LINE" | awk '{print $4 " free of " $2 " (" $5 " used)"}')"
    done

    echo
    echo "Recent log"
    LOG="$(logread 2>/dev/null | grep 'be3600-screen' | grep -v 'daemon.info' | tail -n 6)"
    if [ -n "$LOG" ]; then echo "$LOG" | sed 's/^/         /'; else info "(nothing logged since boot)"; fi

    echo
    if [ "$FAILS" -gt 0 ]; then
        echo "Result: $FAILS problem(s), $WARNS warning(s)."
        return 1
    fi
    echo "Result: all good ($WARNS warning(s))."
    return 0
}

# Play FILE on the screen for SECS seconds (or until a touch), then put everything
# back exactly as it was. Nothing is installed or changed.
preview() {
    FILE="${1:-$BEA}"
    SECS="${2:-10}"

    [ -f "$FILE" ] || { echo "no such file: $FILE"; return 1; }
    case "$SECS" in ''|*[!0-9]*) echo "seconds must be a whole number"; return 1 ;; esac
    if [ "$SECS" -lt 1 ] || [ "$SECS" -gt 600 ]; then echo "seconds must be 1 to 600"; return 1; fi
    lua "$CHECK" "$FILE" || return 1

    WAS_RUNNING=0
    if running; then WAS_RUNNING=1; fi
    PREVIEW_PID=""
    TOUCH_PID=""

    restore() {
        [ -n "$PREVIEW_PID" ] && kill "$PREVIEW_PID" 2>/dev/null
        [ -n "$TOUCH_PID" ] && kill "$TOUCH_PID" 2>/dev/null
        PREVIEW_PID=""
        TOUCH_PID=""
        if [ "$WAS_RUNNING" -eq 1 ]; then
            "$SVC" start
        else
            /etc/init.d/gl_screen restart >/dev/null 2>&1 || true
        fi
    }
    trap 'restore; exit 130' INT TERM HUP

    # The supervisor must stop first (it would fight us for the screen); stopping
    # it brings gl_screen back, so stop that too before drawing.
    if [ "$WAS_RUNNING" -eq 1 ]; then
        "$SVC" stop
        # "stop" returns before the supervisor has finished its clean-up (which kills
        # any player by name), so wait for it to be really gone.
        W=0
        while [ -d "$LOCKDIR" ] && [ "$W" -lt 20 ]; do
            /bin/usleep 250000
            W=$((W + 1))
        done
    fi
    /etc/init.d/gl_screen stop >/dev/null 2>&1 || true
    /bin/usleep 300000
    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true

    if [ -x /usr/bin/be3600-player ]; then
        /usr/bin/be3600-player "$FILE" >/tmp/be3600-preview.log 2>&1 &
    else
        lua /usr/bin/be3600-player.lua "$FILE" >/tmp/be3600-preview.log 2>&1 &
    fi
    PREVIEW_PID=$!
    lua "$TOUCH" >/dev/null 2>&1 &
    TOUCH_PID=$!

    echo "previewing $FILE for $SECS s (touch the screen to stop early)..."
    T=0
    LIMIT=$((SECS * 2))          # checked every half second
    while [ "$T" -lt "$LIMIT" ]; do
        /bin/usleep 500000
        T=$((T + 1))
        if ! kill -0 "$PREVIEW_PID" 2>/dev/null; then echo "the player stopped (see /tmp/be3600-preview.log)"; break; fi
        if ! kill -0 "$TOUCH_PID" 2>/dev/null; then echo "touch: stopping early"; break; fi
    done

    restore
    trap - INT TERM HUP
    echo "done; the screen is back as it was."
}

# ---- pages: what the screen can show besides animations ---------------------
PAGE_LIST="clock analog aurora netspeed talkers vitals info clients internet doctor usage vpn health pomodoro stopwatch message guest wifiqr weather slots chimes custom"

page_desc() {
    case "$1" in
        animations) echo "your saved animations" ;;
        clock) echo "big clock and date" ;;
        analog) echo "an analog watch face with a sweeping second hand" ;;
        aurora) echo "your traffic as drifting light (a screensaver that is also a meter)" ;;
        netspeed) echo "live download / upload speed graph" ;;
        vitals) echo "CPU, memory, storage and temperature" ;;
        info) echo "uptime, load, addresses, firmware" ;;
        clients) echo "Wi-Fi devices with signal strength" ;;
        internet) echo "internet up/down and latency graph" ;;
        doctor) echo "where the trouble is: router, ISP link, internet, name lookups" ;;
        talkers) echo "which device is using the internet right now" ;;
        usage) echo "data used today and this month (DATA_CAP_GB adds a cap bar)" ;;
        vpn) echo "WireGuard / OpenVPN tunnels" ;;
        health) echo "one glance: is everything fine?" ;;
        pomodoro) echo "focus timer (tap start/pause, hold reset)" ;;
        stopwatch) echo "stopwatch (tap start/stop, hold reset)" ;;
        message) echo "a message you set with: be3600-anim say" ;;
        guest) echo "guest Wi-Fi switch (hold to turn on/off)" ;;
        wifiqr) echo "QR code to join a Wi-Fi network (shows its password to anyone who looks)" ;;
        weather) echo "weather (needs WEATHER_LAT / WEATHER_LON in the config)" ;;
        slots) echo "your 3 animation slots (tap to pick one, hold to remove it)" ;;
        chimes) echo "the fan chimes (tap to hear the next one, hold to repeat)" ;;
        custom) echo "pages made by your scripts in /etc/be3600-screen/widgets.d (or custom:NAME)" ;;
    esac
}

page_ok() {   # a page name we know
    case "$1" in
        anim:*|custom:*) case "${1#*:}" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac; return 0 ;;
        animations) return 0 ;;
    esac
    for P in $PAGE_LIST; do [ "$P" = "$1" ] && return 0; done
    return 1
}


pages_now() { P="$(conf_get PAGES)"; echo "${P:-animations}"; }

pages_apply() {
    rm -f "$DATA/page"
    if running; then "$SVC" restart; echo "restarted the screensaver to apply it."; fi
}

pages_list() {
    NOW="$(pages_now)"
    echo "showing, in this order:  $NOW"
    echo
    for P in animations $PAGE_LIST; do
        case " $NOW " in *" $P "*) M="*" ;; *) M="-" ;; esac
        printf '  %s %-11s %s\n' "$M" "$P" "$(page_desc "$P")"
    done
    echo
    echo "change with:  be3600-anim pages set \"animations clock vitals\"   (or add NAME / remove NAME / reset)"
}

pages_cmd() {
    case "$1" in
        ''|list) pages_list ;;
        set)
            shift
            [ $# -ge 1 ] || { echo "usage: be3600-anim pages set \"animations clock ...\""; exit 1; }
            NEW=""
            for P in $(echo "$*" | tr ',' ' '); do
                page_ok "$P" || { echo "unknown page '$P'. Run: be3600-anim pages"; exit 1; }
                NEW="$NEW $P"
            done
            conf_set PAGES "${NEW# }"
            echo "pages: ${NEW# }"
            pages_apply
            ;;
        add)
            page_ok "$2" || { echo "unknown page '$2'. Run: be3600-anim pages"; exit 1; }
            case " $(pages_now) " in *" $2 "*) echo "'$2' is already on."; exit 0 ;; esac
            conf_set PAGES "$(pages_now) $2"
            echo "pages: $(pages_now)"
            pages_apply
            ;;
        remove)
            NEW=""
            for P in $(pages_now); do [ "$P" = "$2" ] || NEW="$NEW $P"; done
            [ -n "$NEW" ] || { echo "that would leave no pages; use: be3600-anim pages reset"; exit 1; }
            conf_set PAGES "${NEW# }"
            echo "pages: ${NEW# }"
            pages_apply
            ;;
        reset)
            conf_set PAGES "animations"
            echo "pages: animations"
            pages_apply
            ;;
        *) echo "usage: be3600-anim pages [list | set \"a b c\" | add NAME | remove NAME | reset]"; exit 1 ;;
    esac
}

# The welcome: the two eyes wake up on the screen while the cooling fan revs. Both last the same
# five seconds, and afterwards everything is put back exactly as it was found.
hello_cmd() {
    [ -x /usr/bin/be3600-player ] || { echo "the welcome needs the native player (this router is using the Lua one)."; return 1; }
    /usr/bin/be3600-player --version 2>/dev/null | grep -q -- --hello || { echo "the installed player is too old for the welcome."; return 1; }

    WAS_RUNNING=0
    if running; then WAS_RUNNING=1; "$SVC" stop; fi
    W=0
    while [ -d "$LOCKDIR" ] && [ "$W" -lt 20 ]; do /bin/usleep 250000; W=$((W + 1)); done
    /etc/init.d/gl_screen stop >/dev/null 2>&1 || true
    /bin/usleep 300000
    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true

    [ -x "$FAN" ] && "$FAN" chime rev --force >/dev/null 2>&1 &
    /usr/bin/be3600-player --hello >/dev/null 2>&1
    wait 2>/dev/null

    # Hand straight over to the screensaver rather than bouncing off the stock screen for the
    # idle countdown; if it was not running, the stock screen is what was there to put back.
    if [ "$WAS_RUNNING" -eq 1 ]; then
        : > /tmp/be3600-screen.show-now
        "$SVC" start >/dev/null 2>&1
    else
        /etc/init.d/gl_screen restart >/dev/null 2>&1 || true
    fi
}

say_cmd() {
    if [ "$1" = "--clear" ]; then rm -f "$MSG"; echo "message cleared."; return 0; fi
    TEXT="$1"
    [ -n "$TEXT" ] || { echo "usage: be3600-anim say \"text\" [red|green|yellow|cyan|orange]   (say --clear removes it)"; exit 1; }
    [ "${#TEXT}" -le 120 ] || { echo "keep it to 120 characters."; exit 1; }
    case "$TEXT" in *[![:print:]]*) echo "plain text only, please."; exit 1 ;; esac
    case "$2" in
        '') printf '%s\n' "$TEXT" > "$MSG" ;;
        red|green|yellow|cyan|orange) printf '!%s %s\n' "$2" "$TEXT" > "$MSG" ;;
        *) echo "colours: red green yellow cyan orange"; exit 1 ;;
    esac
    echo "message set."
    case " $(pages_now) " in *" message "*) ;; *) echo "(it shows on the message page: be3600-anim pages add message)" ;; esac
}

alert_cmd() {
    TEXT="$(printf '%s' "$1" | tr -d '|\n' | cut -c1-80)"
    [ -n "$TEXT" ] || { echo "usage: be3600-anim alert \"text\" [info|good|warn|bad]"; exit 1; }
    case "$2" in ''|info) L=info ;; good|warn|bad) L="$2" ;; *) echo "levels: info good warn bad"; exit 1 ;; esac
    mkdir -p "$DATA"
    echo "$(date +%s)|$L|$TEXT" >> "$DATA/events"
    echo "sent (it shows while the screensaver is on screen)."
}

chime_cmd() {
    [ -x "$FAN" ] || { echo "be3600-fan is not installed."; exit 1; }
    if [ -z "$1" ]; then
        "$FAN" chimes
        echo "the screen plays one with every banner when FAN_CHIME=1 in $CONF."
        return 0
    fi
    "$FAN" chime "$1" --force
}
case "$1" in

on)
    [ -f "$BEA" ] || { echo "no animation at $BEA -- install one with: be3600-anim set FILE.bea"; exit 1; }
    lua "$CHECK" "$BEA" || exit 1
    # Disable first. Where in the boot this starts has changed between versions, and `enable`
    # alone would add the new /etc/rc.d/S??be3600-screensaver next to the old one, which would
    # start the supervisor twice.
    "$SVC" disable >/dev/null 2>&1 || true
    rm -f /etc/rc.d/S[0-9][0-9]be3600-screensaver
    "$SVC" enable
    if running; then "$SVC" restart; else "$SVC" start; fi
    echo "screensaver ON: starts at boot; appears after the idle time; swipe or tap = next animation, double-tap = dismiss."
    ;;

off)
    "$SVC" stop
    "$SVC" disable
    echo "screensaver OFF: stock GL.iNet screen restored, will not start at boot."
    ;;

status)
    if "$SVC" enabled; then echo "boot:       enabled"; else echo "boot:       disabled"; fi
    if running; then echo "supervisor: running (PID $(cat "$LOCKDIR/pid"))"; else echo "supervisor: not running"; fi
    if ps w | grep -q '[b]e3600-player'; then
        echo "display:    custom animation"
    elif ps w | grep -q '[g]l_screen'; then
        echo "display:    GL.iNet stock screen"
    else
        echo "display:    nothing is drawing to it"
    fi
    if [ -f "$BEA" ]; then lua "$CHECK" "$BEA" 2>&1 | sed 's/^/animation:  /'; else echo "animation:  none installed"; fi
    echo "pages:      $(pages_now)"
    ;;

set)
    FILE="$2"
    [ -f "$FILE" ] || usage
    NAME="$(safe_name "${3:-$(basename "$FILE")}")"
    [ -n "$NAME" ] || NAME="animation"
    loop_ok "$FILE" || exit 1

    COUNT="$(lib_count)"
    EXISTS=0
    [ -f "$LIB/$NAME.bea" ] && EXISTS=1
    if [ "$EXISTS" -eq 0 ] && [ "$COUNT" -ge "$MAX_ANIMS" ]; then
        echo "the library is full ($MAX_ANIMS animations). Remove one first:"
        lib_list
        echo "  be3600-anim remove NAME"
        exit 1
    fi

    # Room for the library copy, the playing copy and a "previous" copy, plus a reserve.
    NEED_KB=$(( ($(file_bytes "$FILE") * 3 + 1023) / 1024 + RESERVE_KB ))
    FREE="$(free_kb)"
    if [ -n "$FREE" ] && [ "$FREE" -lt "$NEED_KB" ]; then
        echo "not enough space on the router: ${FREE} KB free, ${NEED_KB} KB needed."
        echo "free some with: be3600-anim list   then   be3600-anim remove NAME"
        exit 1
    fi

    mkdir -p "$LIB" "$(dirname "$BEA")"
    # Never lose the animation that is about to be replaced.
    if [ -f "$BEA" ] && ! cmp -s "$BEA" "$FILE" && ! in_library "$BEA"; then
        AFTER=$((COUNT + 1 - EXISTS))      # files in the library once the new one is added
        if [ -f "$LIB/previous.bea" ] || [ "$AFTER" -lt "$MAX_ANIMS" ]; then
            cp "$BEA" "$LIB/previous.bea.new" && mv "$LIB/previous.bea.new" "$LIB/previous.bea"
            echo "kept the old animation as 'previous'."
        else
            echo "note: the old animation was not kept (the library is full). Remove one to make room next time."
        fi
    fi
    cp "$FILE" "$LIB/$NAME.bea.new" && mv "$LIB/$NAME.bea.new" "$LIB/$NAME.bea" || exit 1
    activate "$LIB/$NAME.bea" || exit 1
    echo "saved as '$NAME' and now the active animation."
    ;;

list)
    if [ "$2" = "--plain" ]; then
        lib_plain
    else
        lib_list
        echo
        echo "$(lib_count) of $MAX_ANIMS animations; each may loop up to $MAX_LOOP_S s; $(free_kb) KB free on the router."
    fi
    ;;

use)
    NAME="$(safe_name "$2")"
    [ -n "$NAME" ] || usage
    [ -f "$LIB/$NAME.bea" ] || { echo "no animation called '$NAME'. You have:"; lib_list; exit 1; }
    loop_ok "$LIB/$NAME.bea" >/dev/null || exit 1
    activate "$LIB/$NAME.bea" || exit 1
    echo "now playing '$NAME'."
    ;;

remove)
    NAME="$(safe_name "$2")"
    [ -n "$NAME" ] || usage
    [ -f "$LIB/$NAME.bea" ] || { echo "no animation called '$NAME'. You have:"; lib_list; exit 1; }
    if cmp -s "$LIB/$NAME.bea" "$BEA"; then
        echo "'$NAME' is playing now; it stays playing, but its saved copy is deleted."
    fi
    rm -f "$LIB/$NAME.bea"
    echo "removed '$NAME'."
    ;;

check)
    lua "$CHECK" "$BEA"
    ;;

doctor)
    doctor
    ;;

preview)
    preview "$2" "$3"
    ;;

pages)
    shift
    pages_cmd "$@"
    ;;

say)
    say_cmd "$2" "$3"
    ;;

alert)
    alert_cmd "$2" "$3"
    ;;

chime)
    chime_cmd "$2"
    ;;

hello)
    hello_cmd
    ;;

*)
    usage
    ;;

esac
