# be3600-screensaver settings (plain shell syntax, sourced by the supervisor).
# Restart after editing:  be3600-anim on

# Animation to play. Replace it with:  be3600-anim set /path/to/file.bea
ANIMATION="/etc/be3600-screen/active.bea"

# Seconds without a touch before the animation starts (0 = immediately).
IDLE_SECONDS=10

# Touchscreen device. Leave empty to find it automatically (the input device
# whose name contains "touch"); set it only if autodetection picks the wrong one,
# e.g. TOUCH_DEVICE="/dev/input/event1".
TOUCH_DEVICE=""

# Which player draws the animation. "auto" uses the native one (exact timing,
# almost no CPU) when it is installed and falls back to the Lua one; "lua"
# forces the Lua player, for example to compare the two.
PLAYER_ENGINE="auto"
