# be3600-screensaver settings. Shell syntax, sourced by the supervisor.
# Apply changes with:  be3600-anim on

# ---- the animation ---------------------------------------------------------------------------

# Replace with:  be3600-anim set /path/to/file.bea
ANIMATION="/etc/be3600-screen/active.bea"

# Seconds without a touch before the screen saver takes over. 0 = at once.
IDLE_SECONDS=10

# Which player. "auto" prefers the native one and falls back to Lua; "lua" forces Lua.
PLAYER_ENGINE="auto"

# Say hello when the router starts up: the eyes wake up on the strip while the fan revs, then
# it goes straight into the screensaver. Once per boot, not on every restart of the service.
# The rev keeps quiet hours (FAN_CHIME_QUIET); the eyes play either way.  be3600-anim hello
HELLO_ON_BOOT=1

# ---- touch -----------------------------------------------------------------------------------

# A second tap within this many seconds counts as a double-tap. Fractions allowed.
# Shorter switches sooner on a single tap; longer gives more room for the second tap.
DOUBLE_TAP_WINDOW_SECONDS=0.3

# Milliseconds a slide between pages takes.
SLIDE_MS=280

# Set to 1 if swipe direction feels backwards.
SWIPE_INVERT=0

# Which touchscreen axis runs along the strip, Y or X. Change only if a swipe along the
# strip is read as a swipe across it.
TOUCH_LONG_AXIS=Y

# Empty autodetects. Set it if the wrong device is picked, e.g. "/dev/input/event1".
TOUCH_DEVICE=""

# ---- pages -----------------------------------------------------------------------------------
# Swipe along the strip to move between them.  be3600-anim pages  lists them.
#
#   animations  your saved animations       clock      big clock and date
#   analog      an analog watch face        aurora     your traffic as drifting light
#   netspeed    live speed graph            talkers    which device is using the internet
#   vitals      CPU, memory, storage, temp  info       uptime, addresses
#   clients     Wi-Fi devices and signal    doctor     router / ISP / internet / name lookups
#   internet    up/down and latency         usage      data used today and this month
#   vpn         VPN tunnels                 health     one glance: is everything fine
#   pomodoro    focus timer (touch)         stopwatch  stopwatch (touch)
#   message     be3600-anim say "..."       guest      guest Wi-Fi switch (hold)
#   wifiqr      QR code to join a network   weather    needs WEATHER_LAT / WEATHER_LON
#   slots       your 3 animations: tap to pick, hold to remove one
#   chimes      the fan chimes: tap to hear the next one
#   custom      your scripts in /etc/be3600-screen/widgets.d, or custom:NAME
#
PAGES="animations"

# Advance to the next page after this many seconds without a touch. 0 = never.
AUTOPLAY_SECONDS=0

# Show a page at a set time, e.g. SCHEDULE="22:00=clock 07:00=animations"
SCHEDULE=""

# ---- alerts ----------------------------------------------------------------------------------

# Banners over whatever is showing: internet down or back, a device joined, a VPN change,
# a timer finishing, the router getting hot, the data cap reached. 0 turns them off.
ALERTS=1

# ---- the fan, as a speaker --------------------------------------------------------------------
# The fan is the only moving part the router has, and its speed is the only thing it can be told,
# so a chime is an engine revving rather than a tune. Five built in (ping, up, down, alert, rev)
# and up to 8 of your own from Fan Studio.  be3600-fan chimes  shows them and what plays them.

# 1 = a banner is heard as well as seen.
FAN_CHIME=0

# Five taps in a row play this chime, from any page. Empty turns that off.
FAN_CHIME_TAPS="rev"

# Hours to stay silent. Empty means any time.
FAN_CHIME_QUIET="22:00-08:00"

# ---- brightness ------------------------------------------------------------------------------

# Between these times the screen dims to NIGHT_BRIGHTNESS, 0 (dark) to 11. A touch wakes it
# for 20 seconds. Empty NIGHT_START turns night mode off.
NIGHT_START=""
NIGHT_END=""
NIGHT_BRIGHTNESS=1

# Brightness outside those hours, 0 to 11. -1 leaves it alone.
DAY_BRIGHTNESS=-1

# ---- what the pages show ---------------------------------------------------------------------

# Clock: 1 = 24-hour, 0 = 12-hour with AM/PM.
CLOCK_24H=1

# Speed graph units: "bits" (Mb/s) or "bytes" (MB/s).
SPEED_UNITS="bits"

# A monthly allowance in GB adds a bar to the data page and an alert when it runs out. 0 = none.
DATA_CAP_GB=0

# What the internet and doctor pages ping. Replies are timed; nothing else is sent.
PING_TARGET="1.1.1.1"

# The name the doctor page looks up to test name resolution.
DNS_PROBE="openwrt.org"

# Pomodoro lengths, in minutes.
POMODORO_FOCUS_MIN=25
POMODORO_SHORT_MIN=5
POMODORO_LONG_MIN=15

# Which network the QR page offers: a section name from /etc/config/wireless, or empty for
# the guest network. It shows the password to anyone looking at the screen, so it is opt-in.
WIFI_QR_SECTION=""

# Weather. open-meteo.com is asked for the forecast; nothing else is sent.
WEATHER_LAT=""
WEATHER_LON=""
WEATHER_UNITS="C"
WEATHER_PLACE=""
